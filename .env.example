# LinkedIn feed store.
#
# Unset: the stub feed is served and the Media section shows its fallback.
# Set: the published Google Sheet is read.
#
# Get this URL from the sheet itself:
#   File > Share > Publish to web > pick the posts tab > Comma-separated values
# It must be the published CSV link on docs.google.com, not the editing URL.
#
# Setup and the Make scenario that fills the sheet are in
# docs/architecture/linkedin-api.md
LINKEDIN_SHEET_CSV_URL=

# Dashboard database: the same Google Sheet, written through the Sheets API.
#
# All three set: every dashboard save is written to the sheet (one tab per
# collection, created on first use) and the site reads from it.
# Unset: the dashboard writes a local JSON file under CMS_DATA_DIR and the site
# falls back to content/cms-snapshot.json.
#
# GOOGLE_SHEET_ID is the id in the editing URL, /d/<id>/edit. Create a service
# account in Google Cloud with the Sheets API enabled, download its JSON key,
# and share the sheet with its client_email as an Editor.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# GitHub: optional. With both set, each dashboard save triggers the
# "Sync dashboard content" workflow, and uploads are committed to public/uploads
# so they survive a serverless host. A fine-grained token on this repository
# with Contents read and write.
GITHUB_REPO=
GITHUB_TOKEN=

# Public address of the site, used for canonical links, share cards, robots.txt
# and sitemap.xml. Falls back to Vercel's production URL, then https://cdie.co.ke.
NEXT_PUBLIC_SITE_URL=

# Contact form delivery. The route tries these in order and the first one
# configured is used. Leave all empty and the form shows the team's address
# instead of sending. Setup for each is in docs/SECRETS_CHECKLIST.md.
#
# 1. Resend: needs a domain verified with Resend. ENQUIRY_FROM is a sender on
#    that domain.
RESEND_API_KEY=
ENQUIRY_FROM=
# 2. Web3Forms: free, no domain. Make the access key with the Gmail address
#    that should receive the forms; the key delivers to that inbox only.
WEB3FORMS_ACCESS_KEY=
# 3. Google Apps Script web app in the receiving Google account. Must be an
#    https://script.google.com/... address.
ENQUIRY_WEBHOOK_URL=
# Where the form goes. Defaults to ive@ku.ac.ke. Web3Forms ignores this and
# uses the inbox its key was made for.
ENQUIRY_TO=

# Admin dashboard sign-in. ADMIN_AUTH=on requires the password; anything else
# leaves /admin open to anyone who knows the address (2026-09-22 decision,
# "no login for the dashboard for now"). Set both before the site is public.
ADMIN_AUTH=
ADMIN_PASSWORD=
# Optional. Signs the session cookie; defaults to the password.
ADMIN_SECRET=
